{
  "lexicon": 1,
  "id": "app.kinship.card.profile",
  "description": "Public base card. Lives in the public repo at rkey 'self'.",
  "defs": {
    "main": {
      "type": "record",
      "key": "literal:self",
      "record": {
        "type": "object",
        "required": ["displayName"],
        "properties": {
          "displayName": { "type": "string", "maxGraphemes": 64, "maxLength": 640 },
          "pronouns": { "type": "string", "maxGraphemes": 32, "maxLength": 320 },
          "bio": { "type": "string", "maxGraphemes": 300, "maxLength": 3000 },
          "avatar": { "type": "blob", "accept": ["image/png", "image/jpeg", "image/webp"], "maxSize": 1000000 },
          "links": { "type": "array", "maxLength": 12, "items": { "type": "ref", "ref": "#link" } }
        }
      }
    },
    "link": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "url": { "type": "string", "format": "uri" },
        "label": { "type": "string", "maxGraphemes": 64, "maxLength": 640 }
      }
    }
  }
}
